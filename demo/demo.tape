Output ../docs/public/demo.gif

Set Shell "bash"
Set FontSize 18
Set Width 1280
Set Height 760
Set Padding 28
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Set WindowBar Colorful

Hide
Type "export PATH=$PWD/bin:$PATH PS1='\[\e[38;5;111m\]$\[\e[0m\] ' && clear"
Enter
Sleep 300ms
Show

Type "# new machine: get my skills"
Sleep 500ms
Enter
Type "skl init you/skills"
Enter
Sleep 1.8s

Type "skl use @backend writing/changelog anthropics/skills/pdf"
Enter
Sleep 2.6s
Type "1"
Sleep 400ms
Enter
Sleep 2.5s

Type "clear && skl status"
Enter
Sleep 3.5s

Type "clear"
Enter
Type "# make my pr-review as good at security as someone else's"
Sleep 500ms
Enter
Type 'skl learn review/pr-review someone/agent-skills/deep-pr-review "I like its security checks"'
Enter
Sleep 4.5s
Type "1"
Sleep 400ms
Enter
Sleep 1.2s
Type "1"
Sleep 400ms
Enter
Sleep 4s
Type "1"
Sleep 400ms
Enter
Sleep 3s

Type "clear && skl history"
Enter
Sleep 2.5s
Type "# changed my mind"
Sleep 400ms
Enter
Type "skl rollback"
Enter
Sleep 3.5s
