# docs/reference/repos.md "How a reference is stored"
#
# "A URL you typed is stored as you typed it, except a password in it: skl drops
# the password and keeps the user, so a token never lands in a committed file."
# (docs PR #155, #139's decision.) What skl prints follows the same rule as what
# it stores (card #163): no message shows the password in a repo URL, and the
# URL shows as you:xxxxx@ instead.

# A usage error names the word without its password.
exitcode 2 skl init 'https://you:secret@git.example.com/you/skills#dev'
! stderr secret
stderr 'https://you:xxxxx@git\.example\.com/you/skills#dev'

# A repo init can't reach: the hint is the command with the password hidden.
exitcode 1 skl init https://you:secret@nonexistent.invalid/you/skills
cmp stderr no-dns.txt

# SKL_DEBUG=1 prints each git command with the password hidden.
env SKL_DEBUG=1
exitcode 1 skl init https://you:secret@nonexistent.invalid/you/skills
! stderr secret
stderr '^.*git ls-remote .*https://you:xxxxx@nonexistent\.invalid/you/skills'
env SKL_DEBUG=

# git's own message, shown when skl can't tell what went wrong, loses the
# password too: an older git, or another tool, may print the URL as it is.
chmod 755 bin/git
env PATH=$WORK/bin:$PATH
exitcode 1 skl init https://you:secret@git.example.com/you/skills
! stderr secret
stderr 'https://you:xxxxx@git\.example\.com/you/skills/'
env PATH=$SKLBIN:$PATH
rm bin/git

# A vault whose origin has a password: init clones it, and SKL_DEBUG=1 never
# shows the password, at init or at sync.
remote you/skills seed
exec git config --global url.file://$REMOTES/github.com/you/skills.git.insteadOf https://you:secret@git.example.com/you/skills
env SKL_DEBUG=1
exec skl init https://you:secret@git.example.com/you/skills
! stderr secret
stderr 'git clone .*https://you:xxxxx@git\.example\.com/you/skills'
exec skl sync
! stderr secret
env SKL_DEBUG=

# An origin skl can't read is shown as it is, but without its password.
exec git -C $HOME/.skl/vault remote set-url origin https://you:secret@nonexistent.invalid/team//skills
exitcode 1 skl sync
! stderr secret
stderr 'can''t reach https://you:xxxxx@nonexistent\.invalid/team//skills'
exitcode 1 skl init you/other
! stderr secret
stderr 'already holds https://you:xxxxx@nonexistent\.invalid/team//skills'

# A vault with no origin: the hint to add one hides the password too.
exec git -C $HOME/.skl/vault remote remove origin
exitcode 1 skl init https://you:secret@git.example.com/you/skills
! stderr secret
stderr 'remote add origin https://you:xxxxx@git\.example\.com/you/skills'

-- no-dns.txt --
✗ can't reach nonexistent.invalid (Could not resolve host)
  · skl init https://you:xxxxx@nonexistent.invalid/you/skills
-- bin/git --
#!/bin/sh
PATH=${PATH#*:}
if [ "$1" = ls-remote ]; then
	echo "fatal: server said no to 'https://you:secret@git.example.com/you/skills/'" >&2
	exit 128
fi
exec git "$@"
-- seed/review/pr-review/SKILL.md --
---
name: pr-review
---
