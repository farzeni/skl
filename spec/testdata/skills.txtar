# docs/guide/skills.md "Edit as usual", "Edit the vault directly", "When the vault
# changed too"; docs/design/architecture.md "Saving back";
# docs/guide/getting-started.md "Work as usual"

remote you/skills seed
exec skl init you/skills
exec skl use review/pr-review
exists $HOME/.skl/generations/2.json

# "Change one by hand, or ask Claude Code to improve it." "The other commands that
# change something (use, add, drop, …) also save them first."
cp edited.md $HOME/.claude/skills/pr-review/SKILL.md
mkdir $HOME/.claude/skills/pr-review/evals
cp evals.json $HOME/.claude/skills/pr-review/evals/evals.json
exec skl add data
cmp stderr saved.txt
cmp $HOME/.skl/vault/review/pr-review/SKILL.md edited.md
cmp $HOME/.skl/vault/review/pr-review/evals/evals.json evals.json
exec git -C $HOME/.skl/vault status --porcelain
! stdout .
# "Each save is a generation, a numbered step in your history": getting-started
# "skl saved your pr-review edits first, as a generation of their own, then"
# the command's own.
grep '"command": "saved pr-review → review/pr-review"' $HOME/.skl/generations/3.json
grep '"command": "add data"' $HOME/.skl/generations/4.json
# docs/design/architecture.md: "`.skl-copy.toml` never enters the vault"
! exists $HOME/.skl/vault/review/pr-review/.skl-copy.toml
# The copy now matches the vault, so the next command saves nothing.
exec git -C $HOME/.skl/vault rev-parse HEAD
cp stdout head.txt
exec sh -c 'grep -q "^commit = \"$(cat head.txt)\"$" $HOME/.claude/skills/pr-review/.skl-copy.toml'
exec skl add data
cmp stderr nothing.txt
! exists $HOME/.skl/generations/5.json

# "git merge-tree sees added, deleted and renamed files": a deleted file.
rm $HOME/.claude/skills/pr-review/evals
exec skl drop data
cmp stderr deleted.txt
! exists $HOME/.skl/vault/review/pr-review/evals

# "skl saves only the files inside the skill's folder. Folders next to it, such as
# the pr-review-workspace/ that skill-creator writes its test runs to, stay out of
# your vault."
mkdir $HOME/.claude/skills/pr-review-workspace
cp evals.json $HOME/.claude/skills/pr-review-workspace/run.json
exec skl add data
cmp stderr workspace-only.txt
! exists $HOME/.skl/vault/review/pr-review-workspace
! exists $HOME/.skl/vault/pr-review-workspace
exists $HOME/.claude/skills/pr-review-workspace/run.json

# "`.skl-copy.toml` never saved back": a copy whose only change is its record has
# nothing to save.
exec skl drop data
exec sh -c 'echo "# note" >> $HOME/.claude/skills/pr-review/.skl-copy.toml'
exec skl add data
cmp stderr add-data.txt

# "You can also edit ~/.skl/vault/<group>/<skill> directly. The next command that
# changes something … commits your edits as a generation of their own and copies
# them into ~/.claude/skills, where Claude Code sees them."
cp hand.md $HOME/.skl/vault/review/pr-review/SKILL.md
exec skl drop data
cmp stderr hand.txt
cmp $HOME/.claude/skills/pr-review/SKILL.md hand.md
exec git -C $HOME/.skl/vault status --porcelain
! stdout .
exec git -C $HOME/.skl/vault log -1 --format=%s
stdout '^skl: commit hand edits$'

# A loaded folder deleted by hand isn't a deletion: it reloads, and the vault keeps
# the skill (docs/guide/skill-sets.md "What's loaded").
rm $HOME/.claude/skills/pr-review
exec skl add data
cmp stderr reloaded.txt
exists $HOME/.skl/vault/review/pr-review/SKILL.md
cmp $HOME/.claude/skills/pr-review/SKILL.md hand.md

# "If a skill changed in the vault after it was loaded … and you changed the loaded
# skill too, skl merges both."
cp long.md $HOME/.skl/vault/review/pr-review/SKILL.md
exec skl drop data
cp long-vault.md $HOME/.skl/vault/review/pr-review/SKILL.md
exec git -C $HOME/.skl/vault commit -q -am 'from the laptop'
cp long-copy.md $HOME/.claude/skills/pr-review/SKILL.md
exec skl add data
cmp stderr merged.txt
cmp $HOME/.skl/vault/review/pr-review/SKILL.md long-both.md
cmp $HOME/.claude/skills/pr-review/SKILL.md long-both.md

# "When both changed the same lines, it asks you how to resolve them, the same way
# as a sync conflict": the merge is left in the vault, and only status, history,
# open and help run until it's finished (docs/reference/commands.md "Errors").
cp long-vault2.md $HOME/.skl/vault/review/pr-review/SKILL.md
exec git -C $HOME/.skl/vault commit -q -am 'again from the laptop'
cp long-copy2.md $HOME/.claude/skills/pr-review/SKILL.md
exitcode 1 skl drop data
cmp stderr conflict.txt
exists $HOME/.skl/vault/.git/MERGE_HEAD
grep '^<<<<<<<' $HOME/.skl/vault/review/pr-review/SKILL.md
cmp $HOME/.claude/skills/pr-review/SKILL.md long-copy2.md
exitcode 1 skl use data
cmp stderr in-progress.txt
exitcode 1 skl use data --dry-run
cmp stderr in-progress-dry.txt
exec skl status
exec git -C $HOME/.skl/vault merge --abort
cp long-both.md $HOME/.claude/skills/pr-review/SKILL.md

# docs/design/architecture.md: "With two targets, each copy is saved back on its
# own, like copies on two machines: the second one merges into the vault the first
# one already changed."
exec skl add data
cp targets.toml $HOME/.skl/config.toml
exec skl use review/pr-review
exists $HOME/.agents/skills/pr-review/.skl-copy.toml
cp long-claude.md $HOME/.claude/skills/pr-review/SKILL.md
cp long-agents.md $HOME/.agents/skills/pr-review/SKILL.md
exec skl add data
cmp stderr two-targets.txt
cmp $HOME/.skl/vault/review/pr-review/SKILL.md long-two.md
cmp $HOME/.claude/skills/pr-review/SKILL.md long-two.md
cmp $HOME/.agents/skills/pr-review/SKILL.md long-two.md
exec git -C $HOME/.skl/vault log -2 --format=%s
cmp stdout two-commits.txt

-- saved.txt --
◇ saved      pr-review → review/pr-review
             SKILL.md, evals/evals.json
◇ generation 3
→ add data
+ sql-explain
! 1 change not pushed · skl sync
✓ generation 4 · skl rollback to undo
-- nothing.txt --
! 1 change not pushed · skl sync
✓ nothing to change
-- deleted.txt --
◇ saved      pr-review → review/pr-review
             evals/evals.json
◇ generation 5
→ drop data
− sql-explain
! 2 changes not pushed · skl sync
✓ generation 6 · skl rollback to undo
-- workspace-only.txt --
→ add data
+ sql-explain
! 2 changes not pushed · skl sync
✓ generation 7 · skl rollback to undo
-- add-data.txt --
→ add data
+ sql-explain
! 2 changes not pushed · skl sync
✓ generation 9 · skl rollback to undo
-- hand.txt --
◇ committed  review/pr-review/SKILL.md
◇ generation 10
→ drop data
~ pr-review   updated
− sql-explain
! 3 changes not pushed · skl sync
✓ generation 11 · skl rollback to undo
-- reloaded.txt --
→ add data
~ pr-review   updated
+ sql-explain
! 3 changes not pushed · skl sync
✓ generation 12 · skl rollback to undo
-- merged.txt --
◇ saved      pr-review → review/pr-review
             SKILL.md
◇ generation 15
→ add data
~ pr-review   updated
+ sql-explain
! 6 changes not pushed · skl sync
✓ generation 16 · skl rollback to undo
-- conflict.txt --
✗ conflict in review/pr-review/SKILL.md · skl sync --continue
-- in-progress.txt --
✗ a sync is in progress · skl sync --continue
-- in-progress-dry.txt --
✗ a sync is in progress · skl sync --continue
-- two-targets.txt --
◇ saved      pr-review → review/pr-review
             SKILL.md
◇ generation 20
→ add data
~ pr-review   updated
+ sql-explain
! 9 changes not pushed · skl sync
✓ generation 21 · skl rollback to undo
-- two-commits.txt --
skl: save pr-review → review/pr-review
skl: save pr-review → review/pr-review
-- targets.toml --
targets = ["claude", "agents"]
-- edited.md --
---
name: pr-review
description: review a PR, sharper
---
Review.
-- evals.json --
{"evals": []}
